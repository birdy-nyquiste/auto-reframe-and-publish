{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "publication.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication_id",
    "created_in_run",
    "created_at",
    "updated_at",
    "task_id",
    "rewrite_commit_sha256",
    "target_id",
    "slug",
    "adapter",
    "milestone",
    "blocker",
    "external_result"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "publication_id": {"type": "string"},
    "created_in_run": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "task_id": {"type": "string"},
    "rewrite_commit_sha256": {"type": "string"},
    "target_id": {"type": "string"},
    "slug": {"type": "string"},
    "adapter": {"type": "string"},
    "presentation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["image_policy", "omitted_markdown_image_count", "source_body_sha256", "published_body_sha256"],
          "properties": {
            "image_policy": {"type": "string", "enum": ["preserve", "omit"]},
            "omitted_markdown_image_count": {"type": "integer", "minimum": 0},
            "source_body_sha256": {"type": "string"},
            "published_body_sha256": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["image_policy", "omitted_markdown_image_count", "source_body_sha256", "published_body_sha256", "cover_image_source", "cover_image_url", "resolved_images"],
          "properties": {
            "image_policy": {"type": "string", "const": "upload"},
            "omitted_markdown_image_count": {"type": "integer", "const": 0},
            "source_body_sha256": {"type": "string"},
            "published_body_sha256": {"type": "string"},
            "cover_image_source": {"type": ["string", "null"]},
            "cover_image_url": {"type": ["string", "null"]},
            "resolved_images": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_name", "asset_sha256", "pathname", "content_type", "url", "is_cover"],
                "properties": {
                  "source_name": {"type": "string"},
                  "asset_sha256": {"type": "string"},
                  "pathname": {"type": "string"},
                  "content_type": {"type": "string"},
                  "url": {"type": "string"},
                  "is_cover": {"type": "boolean"}
                }
              }
            }
          }
        }
      ]
    },
    "image_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_policy", "destination", "cover_image_source", "images"],
      "properties": {
        "image_policy": {"type": "string", "const": "upload"},
        "destination": {"type": "string"},
        "cover_image_source": {"type": ["string", "null"]},
        "images": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_name", "asset_path", "asset_sha256", "pathname", "content_type", "is_cover"],
            "properties": {
              "source_name": {"type": "string"},
              "asset_path": {"type": "string"},
              "asset_sha256": {"type": "string"},
              "pathname": {"type": "string"},
              "content_type": {"type": "string"},
              "is_cover": {"type": "boolean"}
            }
          }
        }
      }
    },
    "milestone": {
      "type": "string",
      "enum": ["publication_created", "request_ready", "publication_confirmed"]
    },
    "blocker": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "error_code", "message"],
          "properties": {
            "kind": {"type": "string", "enum": ["needs_configuration", "permanent_failure", "outcome_unknown"]},
            "error_code": {"type": "string"},
            "message": {"type": "string"}
          }
        }
      ]
    },
    "external_result": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "publication-response.schema.json"}
      ]
    }
  },
  "x-allowed-transitions": {
    "publication_created": ["request_ready"],
    "request_ready": ["publication_confirmed"],
    "publication_confirmed": []
  },
  "x-milestone-invariants": {
    "publication_created": {"external_result": "null"},
    "request_ready": {"external_result": "null"},
    "publication_confirmed": {"external_result": "object", "blocker": "null"}
  }
}
